APP_ENV=production
DATABASE_URL=postgresql+psycopg://rros_app:REPLACE_ME@db.example.com:5432/revenue_recovery
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXP_MINUTES=480
SEED_DEMO=false
LIVE_ACTIONS=false
ATTRIBUTION_WINDOW_DAYS=14
# Generic webhook secrets are server-side only, e.g. WEBHOOK_SECRET_org_abc=...
# Connector credentials belong in a secrets manager; do not commit them here.
PUBLIC_BASE_URL=https://app.example.com
# Fernet-compatible 32-byte URL-safe key; if omitted, derived from JWT_SECRET (rotate both carefully).
INTEGRATION_ENCRYPTION_KEY=
# OAuth credentials are configured per provider as RROS_<PROVIDER>_CLIENT_ID / CLIENT_SECRET.
# Google shared credentials may use RROS_GOOGLE_CLIENT_ID / RROS_GOOGLE_CLIENT_SECRET.

AUTO_CREATE_SCHEMA=false
ALLOWED_HOSTS=app.example.com
REDIS_URL=redis://:REPLACE_ME@redis.example.com:6379/0
REGISTER_RATE_LIMIT_PER_MINUTE=3
LOGIN_RATE_LIMIT_PER_MINUTE=10
APP_VERSION=3.0.0

# Durable runtime
RROS_WORKERS=8
RROS_WORKER_LEASE_SECONDS=300
RROS_SCHEDULER_INTERVAL_SECONDS=60
RROS_SYNC_INTERVAL_SECONDS=300
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
SAFETY_AUDIT_ALL=true
# Feature flags use RROS_FEATURE_<NAME>=true/false, e.g. RROS_FEATURE_GLOBAL_SEARCH=true.
RROS_FEATURE_GLOBAL_SEARCH=true
RROS_FEATURE_GOVERNED_ACTIONS=true
# Comma-separated provider keys that passed live-action certification; keep empty for simulation-only mode.
VERIFIED_LIVE_ADAPTERS=
RROS_QUEUE_TENANT_CONCURRENCY=8
API_RATE_LIMIT_PER_MINUTE=600
# Stripe webhook signing secret for billing checkout reconciliation.
STRIPE_WEBHOOK_SECRET=
